NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shipperex?schema=public"
JWT_ACCESS_SECRET="replace-with-access-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"
GOOGLE_CLIENT_ID="replace-with-google-client-id"
STRIPE_SECRET_KEY="sk_test_replace"
STRIPE_WEBHOOK_SECRET="whsec_replace"
STRIPE_SUCCESS_URL="http://localhost:5000/api/v1/payments/success"
STRIPE_CANCEL_URL="http://localhost:5000/api/v1/payments/cancel"
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379"
CORS_ORIGIN="http://localhost:3000"